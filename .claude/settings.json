            "Bash(git push * -f*)",
            "Bash(git push *--no-verify*)",
            "Bash(git push * main)",
            "Bash(git push * main *)",
            "Bash(git push *:main*)",
            "Bash(git push * develop)",
            "Bash(git push * develop *)",
            "Bash(git push *:develop*)",
            "Bash(git push *+*)",
            "Read(./.env)",
            "Read(./.env.*)"
        ]
    }
}
